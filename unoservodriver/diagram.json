{
  "version": 1,
  "author": "kiwijam-2026",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-arduino-uno", "id": "uno", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-servo", "id": "servo1", "top": -110, "left": 200, "attrs": {} },
    {
      "type": "wokwi-resistor",
      "id": "controlPulldown",
      "top": 85,
      "left": 210,
      "rotate": 90,
      "attrs": { "value": "10000" }
    },
    { "type": "wokwi-vcc", "id": "servo5v", "top": -145, "left": 335, "attrs": {} },
    { "type": "wokwi-gnd", "id": "sharedGnd", "top": 25, "left": 335, "attrs": {} },
    {
      "type": "wokwi-logic-analyzer",
      "id": "logic1",
      "top": 130,
      "left": 300,
      "attrs": {}
    },
    {
      "type": "wokwi-text",
      "id": "pinInfo",
      "top": -190,
      "left": -20,
      "attrs": {
        "text": "UNO SERVO DRIVER\nD2  <- Pi TTL PWM: 50 Hz, 1000-2000 us HIGH\nD9  -> Hardware-timed 50 Hz servo PWM\nD13 -> Control-link status (onboard LED)\nD0/D1 UART: reserved, currently unused"
      }
    },
    {
      "type": "wokwi-text",
      "id": "controlInfo",
      "top": 110,
      "left": -20,
      "attrs": {
        "text": "D2 requires a 10k pulldown and a validated\n3.3 V-to-5 V level shifter/buffer from the Pi.\nUse an external rated 5 V servo supply.\nAll Pi, Uno and servo grounds must be shared.\nSignal loss centers the servo after 100-120 ms."
      }
    }
  ],
  "connections": [
    [ "servo1:PWM", "uno:9", "green", [ "h0" ] ],
    [ "servo1:V+", "servo5v:VCC", "red", [ "h0" ] ],
    [ "servo1:GND", "sharedGnd:GND", "black", [ "h0" ] ],
    [ "uno:GND.1", "sharedGnd:GND", "black", [ "h0" ] ],
    [ "controlPulldown:1", "uno:2", "blue", [ "h-30" ] ],
    [ "controlPulldown:2", "sharedGnd:GND", "black", [ "h40" ] ],
    [ "logic1:D0", "uno:2", "blue", [ "h-60", "v-20" ] ],
    [ "logic1:D1", "uno:9", "green", [ "h-40", "v-40" ] ],
    [ "logic1:D2", "uno:13", "orange", [ "h-20", "v-60" ] ],
    [ "logic1:GND", "uno:GND.2", "black", [ "h-80" ] ]
  ],
  "dependencies": {}
}
