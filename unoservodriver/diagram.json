  "parts": [
    { "type": "wokwi-arduino-uno", "id": "uno", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-servo", "id": "servo1", "top": -110, "left": 200, "attrs": {} },
    { "type": "wokwi-servo", "id": "servo2", "top": -110, "left": 430, "attrs": {} },
    { "type": "wokwi-vcc", "id": "servo5v", "top": -145, "left": 335, "attrs": {} },
    { "type": "wokwi-gnd", "id": "sharedGnd", "top": 25, "left": 335, "attrs": {} },
    {
      "type": "wokwi-logic-analyzer",
      "id": "logic1",
      "top": 130,
      "left": 300,
      "attrs": {}
    },
    {
      "type": "wokwi-text",
      "id": "pinInfo",
      "top": -190,
      "left": -20,
      "attrs": {
        "text": "TWO-PLAYER UNO SERVO DRIVER\nPi USB serial -> Uno UART at 115200 baud\nD9/OC1A -> Servo 1; D10/OC1B -> Servo 2\nBoth outputs: hardware-timed 50 Hz\nD13 ON -> valid serial frames arriving"
      }
    },
    {
      "type": "wokwi-text",
      "id": "controlInfo",
      "top": 110,
      "left": -20,
      "attrs": {
        "text": "Connect the Uno to the Pi by USB; GPIO control\nwires and level shifting are no longer required.\nUse one external 5 V supply rated for both servos.\nA serial timeout centers both servos."
      }
    }
  ],
  "connections": [
    [ "servo1:PWM", "uno:9", "green", [ "h0" ] ],
    [ "servo1:V+", "servo5v:VCC", "red", [ "h0" ] ],
    [ "servo1:GND", "sharedGnd:GND", "black", [ "h0" ] ],
    [ "servo2:PWM", "uno:10", "purple", [ "h0" ] ],
    [ "servo2:V+", "servo5v:VCC", "red", [ "h0" ] ],
    [ "servo2:GND", "sharedGnd:GND", "black", [ "h0" ] ],
    [ "uno:GND.1", "sharedGnd:GND", "black", [ "h0" ] ],
    [ "logic1:D0", "uno:9", "green", [ "h-40", "v-40" ] ],
    [ "logic1:D1", "uno:10", "purple", [ "h-30", "v-50" ] ],
    [ "logic1:D2", "uno:13", "orange", [ "h-20", "v-60" ] ],
    [ "logic1:GND", "uno:GND.2", "black", [ "h-80" ] ]
